[Unit]
Description=Cargo Tracker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.local/opt/cargo-tracker
EnvironmentFile=%h/.config/cargo-tracker/app.env
ExecStart=%h/.local/opt/node/bin/node server.mjs
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
