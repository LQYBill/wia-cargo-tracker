# Copy outside the source tree, chmod 600; never commit real secrets.
HOST=127.0.0.1
PORT=5187
APP_ORIGIN=https://cargo.example.com
CARGO_DATA_DIR=/home/CHANGE_ME/.local/share/cargo-tracker
# Generate using npm run password
ADMIN_PASSWORD_HASH=CHANGE_ME
# Optional: official API, charged and limited by your 17TRACK plan.
TRACK17_TOKEN=
# Default: unattended website queries, no API token required.
TRACKING_SOURCE=website
MONITOR_TIMEZONE=Europe/Paris
MONITOR_HOUR=22
# Optional on Windows: msedge. Leave empty for installed Chromium on Ubuntu.
TRACKING_BROWSER_CHANNEL=
# Ubuntu commands (optional for local label OCR)
TESSERACT_BIN=/usr/bin/tesseract
IMAGEMAGICK_BIN=/usr/bin/convert
